; The SPA uses TypeScript 6 but openapi-typescript pins
; ``typescript@^5.x`` as a peer dep — incompatible declaration,
; but the tool itself works fine on TS 6. ``legacy-peer-deps``
; lets ``npm ci`` ignore the spurious peer warning so both local
; ``npm install`` and CI's ``npm ci`` resolve the tree the same
; way. Drop this file the moment openapi-typescript widens its
; peer range to ``^5 || ^6``.
legacy-peer-deps=true
