    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.52.0",
    "@tanstack/react-query": "^5.100.9",
    "chart.js": "^4.5.1",
    "cmdk": "^1.1.1",
    "libphonenumber-js": "^1.13.9",
    "react": "^19.2.5",
    "react-chartjs-2": "^5.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^7.15.0",
    "zod": "^4.4.3"
