{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-types": "cd .. && python -m scripts.dump_openapi > frontend/src/api/openapi.json && cd frontend && openapi-typescript src/api/openapi.json -o src/api/openapi.d.ts"
  },
  "dependencies": {
