# Coverage.py config. Mirrors what the CI step calls explicitly so a
# local `coverage run -m pytest` matches CI behavior.
[run]
source = app
# Required on Python 3.12: without it, coverage's tracer interacts
# badly with FastAPI/asyncio task cleanup. The "Task was destroyed
# but it is pending!" warnings get promoted to errors that corrupt
# SQLAlchemy session state for the next test (manifests as
# `test_unlock_404_when_no_report` failing at SETUP because the
# seeded test-store row goes missing).
#
# Verified locally on Python 3.12.3:
#   • Without concurrency=thread: 1 ERROR (test_unlock_404 SETUP)
#   • With concurrency=thread:    0 errors, 2361 passed
#
# The flag is a no-op semantically — our code is single-threaded on
# the asyncio event loop — but coverage's `concurrency` hint makes
# its tracer thread-safe for the asyncio bridge it implicitly
# creates.
concurrency = thread

[report]
fail_under = 60
