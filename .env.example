# Local-dev env template. Copy to `.env` (which is gitignored) and
# fill in the values you need. The defaults below match what the
# Pydantic settings model (``api/Core/Config/settings.py``) falls
# back to when an env var is unset, so leaving most blank just
# uses the in-code defaults.
#
# Anything tagged ``REQUIRED FOR <flow>`` blocks that specific
# user flow if missing — the rest of the app keeps working.

# ── Database ────────────────────────────────────────────────────
# Default (unset): SQLite file in the repo root. Good enough for
# UI iteration but diverges from Postgres in prod — see the
# "Postgres in dev" section in README.md for the docker-compose
# alternative.
#
# DATABASE_URL=postgresql://dinerobook:dinerobook@localhost:5432/dinerobook

# ── Auth / sessions ─────────────────────────────────────────────
# JWT signing secret. Production sets this to a random 32+ byte
# value. Dev fallback is fine for local-only use.
# SECRET_KEY=dev-secret-key-do-not-use-in-prod
# AUTH_JWT_SECRET=<separate-secret-for-jwt-rotation-independent-of-cookies>

# ── Seed passwords (first boot) ─────────────────────────────────
# init_db creates ``superadmin`` + a demo ``admin`` user on first
# boot. These passwords let you log in immediately; rotate ASAP
# in any non-local environment.
# SUPERADMIN_PASSWORD=super2025!
# ADMIN_PASSWORD=cambio2025!

# ── Stripe (REQUIRED FOR billing flows) ─────────────────────────
# Without these, /subscribe redirects fail and webhooks are
# unverifiable. Use ``sk_test_*`` + ``whsec_*`` from the Stripe
# dashboard in test mode; never paste prod ``sk_live_*`` here.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_BASIC_PRICE_ID=price_...
# STRIPE_BASIC_YEARLY_PRICE_ID=price_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_PRO_YEARLY_PRICE_ID=price_...

# ── SMTP (REQUIRED FOR password reset / announcement emails) ────
# When unset, password-reset URLs get logged at WARNING level
# instead of emailed — fine for dev. Gmail + an App Password is
# the easiest path.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=<16-char Google App Password>
# SMTP_FROM=your-gmail@gmail.com

# ── Sentry (optional) ───────────────────────────────────────────
# Opt-in error tracking — set the DSN to enable, leave empty to
# disable. Both Python + React read this same DSN.
# SENTRY_DSN=https://...@o....ingest.sentry.io/...

# ── WebAuthn / passkeys ─────────────────────────────────────────
# Production pins this to the canonical domain so passkeys are
# bound to it. Dev falls back to the request Host header (with
# port stripped), so localhost:5000 just works without setting
# anything.
# WEBAUTHN_RP_ID=dinerobook.com
# APP_BASE_URL=https://dinerobook.com

# ── Rate limiting (BACKLOG D6) ──────────────────────────────────
# slowapi backs auth/webhook routes. In-memory default is fine
# for single-process dev. Set this to a Redis URL to share the
# bucket across workers in prod.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# RATELIMIT_ENABLED=1

# ── Background-job queue (BACKLOG D5) ───────────────────────────
# When BOTH are set, ``api.Core.Jobs.enqueue(...)`` pushes work
# to a Redis-backed RQ queue instead of running synchronously.
# A worker process (``rq worker default``) drains the queue.
# Either missing → sync execution (the default; same behavior
# as a direct call). See CLAUDE.md invariant #16.
# REDIS_URL=redis://localhost:6379/0
# JOB_QUEUE_ENABLED=1
